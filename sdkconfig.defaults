# 目标芯片与 Flash（开发板 P4V3_V3.8：ESP32-P4 + 16MB Flash）
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 分区表：默认 singleapp 只给 factory 1MB；且默认偏移 0x8000 装不下 P4 的 bootloader
# （实测 0x6140 = 24896 B > 0x6000 上限）。必须偏移 0x10000，见 partitions_p4.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_p4.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# 性能（后续 OTA 大流量传输留余量）
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---------------- PSRAM（阶段 8 UI 必需） ----------------
# 模组带 32 MB PSRAM，hex 模式（3D 堆叠）。不开启时堆只有 ~520 KB，
# LVGL 的 100 KB 绘制缓冲 + 页面对象会把内部 RAM 吃紧。
# 暂不开 SPIRAM_XIP_FROM_PSRAM：代码仍从 Flash 跑，只把 PSRAM 当内存池，
# 少一层 cache 配置，出问题好定位。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# 找不到 PSRAM 也照常启动（LVGL 缓冲在内部 RAM，不依赖 PSRAM），
# 免得第一次点亮时因为 PSRAM 时序不对直接 panic，把屏的问题掩盖掉
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# 任务栈：事件循环与主任务
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# DHCP Server：ETH netif 上跑 DHCP 依赖这一项（默认 y，显式写出避免被别的配置带偏）
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_DHCPS_REPORT_CLIENT_HOSTNAME=y
CONFIG_LWIP_DHCPS_MAX_HOSTNAME_LEN=32
# 租约表大小：默认 8，与地址池数量无关（池再大也只能同时挂 8 台）。按 16 留余量。
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=16

# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---------------- LVGL 9（阶段 8 UI） ----------------
# 走 IDF 的 Kconfig 而不是外部 lv_conf.h（CONFIG_LV_CONF_SKIP=y 是 lvgl 组件默认）
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
# 界面用到 14（正文/表格）和 20（标题）两档字号，其余不开，省 Flash
# 14 = 正文/标签，20 = 列表主行，28 = 页面大标题与关键数字（iPadOS 风格的大字号层次）
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
