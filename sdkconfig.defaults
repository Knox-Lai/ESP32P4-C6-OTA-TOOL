# 目标芯片与 Flash（开发板 P4V3_V3.8：ESP32-P4 + 16MB Flash）
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 分区表：默认 singleapp 只给 factory 1MB；且默认偏移 0x8000 装不下 P4 的 bootloader
# （实测 0x6140 = 24896 B > 0x6000 上限）。必须偏移 0x10000，见 partitions_p4.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_p4.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# 性能（后续 OTA 大流量传输留余量）
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# ---------------- PSRAM（阶段 8 UI 必需） ----------------
# 模组带 32 MB PSRAM，hex 模式（3D 堆叠）。不开启时堆只有 ~520 KB，
# LVGL 的 100 KB 绘制缓冲 + 页面对象会把内部 RAM 吃紧。
# 暂不开 SPIRAM_XIP_FROM_PSRAM：代码仍从 Flash 跑，只把 PSRAM 当内存池，
# 少一层 cache 配置，出问题好定位。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
# 找不到 PSRAM 也照常启动（LVGL 缓冲在内部 RAM，不依赖 PSRAM），
# 免得第一次点亮时因为 PSRAM 时序不对直接 panic，把屏的问题掩盖掉
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y

# 任务栈：事件循环与主任务
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_HZ=1000

# FreeRTOS 运行统计：主页 CPU 折线靠 uxTaskGetSystemState() 统计全部任务。
# 这两项原来是直接在 sdkconfig 里点开的（没进 defaults），
# 一旦为了新增组件重生成 sdkconfig 就会丢，界面会编译不过 —— 所以补写在这里。
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_STATS_USING_ESP_TIMER=y

# DHCP Server：ETH netif 上跑 DHCP 依赖这一项（默认 y，显式写出避免被别的配置带偏）
CONFIG_LWIP_DHCPS=y
CONFIG_LWIP_DHCPS_REPORT_CLIENT_HOSTNAME=y
CONFIG_LWIP_DHCPS_MAX_HOSTNAME_LEN=32
# 租约表大小：默认 8，与地址池数量无关（池再大也只能同时挂 8 台）。按 16 留余量。
CONFIG_LWIP_DHCPS_MAX_STATION_NUM=16

# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---------------- LVGL 9（阶段 8 UI） ----------------
# 走 IDF 的 Kconfig 而不是外部 lv_conf.h（CONFIG_LV_CONF_SKIP=y 是 lvgl 组件默认）
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
# 界面用到 14（正文/表格）和 20（标题）两档字号，其余不开，省 Flash
# 14 = 正文/标签，20 = 列表主行，28 = 页面大标题与关键数字（iPadOS 风格的大字号层次）
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# ---------------- WiFi（P4 主机 + 板载 C6 从机，esp_hosted） ----------------
# P4 没有射频，esp_wifi 的库实现必须走远程（RPC 到 C6），不能选本地。
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
# 从机型号：不写默认不是 C6，esp_hosted 会按错误的目标去准备 slave 固件。
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
# SDIO 引脚用 esp_hosted 默认值，与本板 C6 连线一致：
#   CLK=18  CMD=19  D0=14 D1=15 D2=16 D3=17  RESET=54  slot=1  4bit 40MHz
# slot1 不能和 TF 卡（SDMMC slot0）抢同一个控制器。
# 若某天换板子，只改 CONFIG_ESP_HOSTED_HOST_SDIO_PIN_* / _RESET_GPIO 即可。
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
